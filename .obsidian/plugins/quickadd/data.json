    {
      "id": "f980c863-c611-4930-a89d-5ca89285a70d",
      "name": "AVG-dialog",
      "type": "Capture",
      "command": true,
      "appendLink": false,
      "captureTo": "",
      "captureToActiveFile": true,
      "createFileIfItDoesntExist": {
        "enabled": false,
